// See config docs here: https://opencode.ai/v2/docs/config
{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "opencode-go/gemini-4-argon",
  "provider": {
    "opencode-go": {
      "models": {
        "gemini-4-argon": {
          "settings": {
            "reasoningEffort": "low"
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/.cache/uv/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/**",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/buckets/**",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "marimo-pair",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "marimo-notebook",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "write",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "apply_patch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "bash */execute-code.sh *",
      "effect": "ask"
    },
  ]
}
