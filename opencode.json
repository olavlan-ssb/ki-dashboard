// See config docs here: https://opencode.ai/v2/docs/config
{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "opencode-go/gpt-5.6-luna",
  "providers": {
    "opencode-go": {
      "models": {
        "gpt-5.6-luna": {
          "settings": {
            "reasoningEffort": "low"
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/buckets/*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "bash */marimo-pair/scripts/execute_code.sh *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "bash */marimo_pair/scripts/discover_servers.sh *",
      "effect": "allow"
    }
  ]
}
